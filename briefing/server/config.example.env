# Copy to briefing/server/config.env (not committed) and adjust.

# Public URL of the web app inside your tailnet (shown by `tailscale serve status`).
SITE_URL="https://myserver.tail1234.ts.net/briefing/"

# Folder the web app is served from (setup.sh points tailscale serve at it).
SITE_DIR="$HOME/morning-briefing-site"

# ntfy: topic, and an optional access token (tk_...). Leave NTFY_TOKEN empty for anonymous.
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC="morning-briefing-a65163607472"
NTFY_TOKEN=""

# Claude model for the writing step. sonnet is much lighter on subscription limits than opus.
CLAUDE_MODEL="sonnet"
CLAUDE_BIN="claude"

# Hard time limit for the writing step, in seconds.
CLAUDE_TIMEOUT=5400

# 1 = git push the new edition to origin after committing; 0 = commit locally only.
GIT_PUSH=0
